# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Connect → Connect your application
# IMPORTANT: Use a Replica Set connection string for ACID transactions
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ludo_arena?retryWrites=true&w=majority

# ─── JWT (generate a strong random string — min 32 chars) ────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=7d

# ─── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET

# ─── CORS (your Vercel frontend URL) ─────────────────────────────────────────
# After deploying frontend, replace with your Vercel URL
CLIENT_URL=https://your-app.vercel.app

# ─── Admin seed account ───────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=YourStrongAdminPassword@123
SEED_ADMIN_USERNAME=superadmin

# ─── Wallet ───────────────────────────────────────────────────────────────────
REGISTRATION_BONUS=50
DAILY_LOGIN_REWARD=100
